# ===== Server =====
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/gym-management-system

# JWT (use long random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Biometric template encryption (32-byte key, hex = 64 chars, or base64)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BIOMETRIC_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Face recognition matching threshold (Euclidean distance; lower = stricter)
FACE_MATCH_THRESHOLD=0.6

# Password reset token lifetime (minutes)
PASSWORD_RESET_EXPIRES_MINUTES=30

# ===== Client =====
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
